#!/usr/bin/env bash
# Usage: bin/run [--target rails|crails] [minitest args, e.g. -n /auth/]
# Boots the target locally against a fresh seed copy, runs the suite, tears
# the server down. Artifacts land in artifacts/<target>/.
set -euo pipefail
cd "$(dirname "$0")/.."

export TARGET="${TARGET:-rails}"
if [[ "${1:-}" == "--target" ]]; then TARGET="$2"; shift 2; fi
case "$TARGET" in rails|crails) ;; *) echo "unknown target: $TARGET" >&2; exit 2 ;; esac
export TARGET

export PARITY_RUBY="${PARITY_RUBY:-$HOME/.asdf/installs/ruby/4.0.7/bin/ruby}"
export PATH="$(dirname "$PARITY_RUBY"):$PATH"
# Strip the inherited bundler context too: when we're spawned from an outer
# `bundle exec` (e.g. twinshot generate), BUNDLE_GEMFILE/BUNDLER_SETUP point
# at a foreign Gemfile and our own `bundle exec run.rb` resolves the wrong
# lockfile. RUBYOPT is unset as well (bundler injects -rbundler/setup).
unset GEM_HOME GEM_PATH RUBY_VERSION MY_RUBY_HOME IRBRC RUBYOPT 2>/dev/null || true
unset BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_SETUP BUNDLER_SETUP BUNDLE_VERSION \
      BUNDLE_PLUGIN_PATH BUNDLE_USER_CACHE BUNDLE_USER_CONFIG BUNDLE_USER_PLUGIN 2>/dev/null || true
# Clear whatever artifacts dir this run will write to (honors PARITY_ARTIFACTS).
ARTIFACTS_DIR="${PARITY_ARTIFACTS:-$PWD/artifacts/$TARGET}"
rm -rf "$ARTIFACTS_DIR"

# Fixed seed ⇒ fixed test order ⇒ identical cross-test contamination in
# every run, which the determinism and parity comparisons rely on.
"$PARITY_RUBY" -S bundle exec ruby run.rb --seed "${PARITY_SEED:-20260302}" "$@"
exit "$?"
