# Crystal
/lib/
/bin/*
!/bin/docker-build.sh
!/bin/crails
/tmp/
*.dwarf

# Local databases (copies of the benchmark seed)
db/*.sqlite3
db/*.sqlite3-shm
db/*.sqlite3-wal

# Runtime
/log/
/storage
.env

# Сгенерированные ассеты: `bin/crails assets:precompile` собирает
# public/assets из исходников в репо (app/assets, app/javascript,
# vendor/assets, vendor/javascript — как Rails-референс с importmap,
# без node). app/views/manifest.json — тот же пребилд, встраивается
# при компиляции.
/public/assets/

# Rake-бенчмарк: рабочее окружение (клоны конкурентов, harness, сид)
/bench-workspace/

# Ruby-гемы rake-пайплайна (Gemfile → vendor/bundle); исходники
# vendor-ассетов (vendor/javascript, vendor/assets, vendor/licenses)
# — в репо, как у Rails-референса.
/.bundle/
/vendor/bundle/

benchmarks/

once-campfire/

# Локальный override шардов (dev): теги не запушены
/shard.override.yml
twinshot-report/
