<%= page_open(@user.not_nil!) %><section class="panel flex flex-column gap" style="view-transition-name: avatar-<%= @user.not_nil!.id %>">
  <%= install_instructions %>
  <div class="align-center center avatar__form gap" data-controller="upload-preview">
    <form accept-charset="UTF-8" action="/users/me/profile" class="txt-medium" data-controller="form" enctype="multipart/form-data" method="post"><input name="_method" type="hidden" value="patch">
      <label class="btn input--file">
        <%= icon("camera.svg") %>
        <input accept="image/*" class="input" data-action="upload-preview#previewImage change-&gt;form#submit" data-upload-preview-target="input" id="file" name="user[avatar]" type="file">
        <span class="for-screen-reader">Upload avatar</span>
      </label>
    </form>
    <form accept-charset="UTF-8" action="/users/me/profile" data-controller="form" enctype="multipart/form-data" method="post"><input name="_method" type="hidden" value="patch">
      <label class="btn avatar input--file txt-xx-large">
        <img aria-hidden="true" data-upload-preview-target="image" height="300" src="<%= fresh_avatar_path(@user.not_nil!) %>" width="300">
        <input accept="image/*" class="input" data-action="upload-preview#previewImage change-&gt;form#submit" data-upload-preview-target="input" id="file" name="user[avatar]" type="file">
        <span class="for-screen-reader">Avatar</span>
      </label>
    </form>
  </div>
  <form accept-charset="UTF-8" action="/users/me/profile" data-controller="form" method="post"><input name="_method" type="hidden" value="patch">
    <div class="flex flex-column gap">
      <div class="flex align-center gap">
        <%= translation_button("user_name") %>
        <label class="flex align-center gap flex-item-grow input input--actor">
          <input autocomplete="name" autofocus="autofocus" class="input txt-large " data-1p-ignore="true" id="user_name" name="user[name]" placeholder="Enter your name" required="required" type="text" value="<%= @user.not_nil!.name.to_s %>">
          <%= icon("person.svg", 24, "colorize--black") %>
        </label>
      </div>
      <div class="flex align-center gap">
        <%= translation_button("email_address") %>
        <label class="flex align-center gap flex-item-grow input input--actor">
          <input autocomplete="username" class="input txt-large" id="user_email_address" name="user[email_address]" placeholder="Enter your email address" type="email" value="<%= @user.not_nil!.email_address.to_s %>">
          <%= icon("email.svg", 24, "colorize--black") %>
        </label>
      </div>
      <div class="flex align-center gap">
        <%= translation_button("update_password") %>
        <label class="flex align-center gap flex-item-grow input input--actor">
          <input autocomplete="new-password" class="input txt-large" id="user_password" maxlength="72" name="user[password]" placeholder="Change password" size="72" type="password">
          <%= icon("password.svg", 24, "colorize--black") %>
        </label>
      </div>
      <div class="flex align-start gap">
        <%= translation_button("bio") %>
        <label class="flex align--center gap flex-item--grow input input--actor">
          <textarea class="input txt-large" id="user_bio" maxlength="200" name="user[bio]" placeholder="A few words about yourself…" rows="3"><%= @user.not_nil!.bio.to_s %></textarea>
          <%= icon("bio.svg", 24, "colorize--black") %>
        </label>
      </div>
      <button class="btn btn--reversed center txt-large" type="submit"><%= icon("check.svg") %><span class="for-screen-reader">Save changes</span></button>
    </div>
  </form>
  <div class="margin-block pad-inline pad-block fill-shade border-radius">
    <menu class="flex flex-column gap margin-none pad">
      <% viewer = @user.not_nil! %>
<% @shared_memberships.each do |room, membership| %><%= membership_row(room, membership, viewer) %>
      <% end %><% if !@shared_memberships.empty? && !@direct_memberships.empty? %><hr class="separator full-width" style="--border-style: solid">
      <% end %><% @direct_memberships.each do |room, membership| %><%= membership_row(room, membership, viewer) %>
      <% end %></menu>
  </div>
  <fieldset>
    <legend class="gap">
      <%= icon("laptop.svg", 36, "colorize--black") %>
      <%= icon("transfer.svg", 36, "colorize--black") %>
      <%= icon("mobile-phone.svg", 36, "colorize--black") %>
    </legend>
    <div class="flex flex-column gap">
      <label class="for-screen-reader" for="session_transfer_url">Use this link to login automatically on another device</label>
      <input class="input" id="session_transfer_url" readonly="" type="text" value="<%= @transfer_url %>">
      <div class="flex align-center center gap">
        <a class="btn" data-action="lightbox#open" data-lightbox-target="image" data-lightbox-url-value="<%= @qr_path %>" href="<%= @qr_path %>">
          <span class="for-screen-reader">Show auto-login QR code</span>
          <%= icon("qr-code.svg", 20, "colorize--black") %>
        </a>
        <%= copy_button(@transfer_url) %>
        <%= web_share_button(@transfer_url) %>    </div>
    </div>
  </fieldset>
</section>
<%= page_close %>
