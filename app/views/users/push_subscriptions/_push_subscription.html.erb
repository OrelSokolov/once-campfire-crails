<li class="flex flex-column margin-none membership-item">
  <span class="overflow-ellipsis txt-primary txt-undecorated">
    <strong><%= user_agent_summary(push_subscription.user_agent) %></strong><br>
  </span>

  <span class="flex align-start gap txt-small">
    <span><%= push_subscription.endpoint %></span>

    <span class="flex align-center gap">
      <%= button_to "/users/me/push_subscriptions/#{push_subscription.id}/test_notifications", class: "btn btn--reversed" do %>
        <%= icon("notification-bell-everything.svg") %>
        <span class="for-screen-reader">Send test notification</span>
      <% end %>

      <%= button_to "/users/me/push_subscriptions/#{push_subscription.id}", method: "delete", class: "btn btn--negative" do %>
        <%= icon("minus.svg") %>
        <span class="for-screen-reader">Delete subscription</span>
      <% end %>
    </span>
  </span>
</li>
