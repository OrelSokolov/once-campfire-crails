<% viewer = @viewer.not_nil! %>
<% subject = @subject.not_nil! %>
<%= page_open(viewer, subject) %><section class="panel txt-align-center">
  <div class="flex flex-column gap <%= subject.banned? ? "banned" : "" %>">
    <div class="avatar txt-xx-large center" style="background: white">
      <img alt="Profile avatar" class="avatar" src="<%= fresh_user_avatar_path(subject) %>">
    </div>
    <% if subject.bot? %><div class="pad-double--inline push--inline push--block-start"><% if subject.active? %><%= button_to_direct_room_with(subject) %><% else %><div><%= subject.name.to_s %> is no longer on this account</div><% end %></div><% elsif subject.deactivated? %><div><h1 class="txt-x-large margin-none"><%= subject.name.to_s %></h1><div><%= subject.name.to_s %> is no longer on this account</div></div><% else %><div class="flex flex-column gap" style="--row-gap: calc(var(--block-space) / 3)">
      <h1 class="txt-x-large txt-tight-lines margin-none"><%= subject.name.to_s %></h1>
      <% if viewer.can_administer? %><div><a href="mailto:<%= subject.email_address.to_s %>"><%= subject.email_address.to_s %></a></div><% end %>
      <div><%= subject.bio.to_s %></div>
    </div>
    <% if subject.active? %><div class="pad-inline-double margin-inline margin-block-start"><%= button_to "/rooms/directs?user_ids%5B%5D=#{subject.id}", class: "btn btn--reversed full-width txt-large" do %>
      <img aria-hidden="true" aria-label="Ping <%= subject.name.to_s %>" src="<%= asset("messages.svg") %>">
    <% end %>          </div>
    <% if viewer.can_administer? && viewer != subject %><hr class="margin-block-start borderless"><%= transfer_link(subject) %>
      <div class="margin-block-start">
        <%= button_to "/users/#{subject.id}/ban", method: "post", class: "btn full-width", data: {turbo_confirm: "Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses."} do %>
          <img aria-hidden="true" aria-label="Ban <%= subject.name.to_s %>" src="<%= asset("cancel.svg") %>">
          <span>Ban <%= subject.name.to_s %></span>
        <% end %>
      </div>
    <% end %>
    <% end %>
    <% if viewer.can_administer? && viewer != subject && subject.banned? %><div class="margin-block-start">
      <%= button_to "/users/#{subject.id}/ban", method: "delete", class: "btn btn--negative full-width", data: {turbo_confirm: "Are you sure you want to remove the ban on this user?"} do %>
        <img aria-hidden="true" aria-label="Remove Ban <%= subject.name.to_s %>" src="<%= asset("cancel.svg") %>">
        <span>Remove ban</span>
      <% end %>
    </div><% end %><% end %></div>
</section>
<%= page_close %>
