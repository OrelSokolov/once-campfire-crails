<% viewer = @viewer.not_nil! %>
<% subject = @subject.not_nil! %>
<%= page_open(viewer, subject) %><section class="panel txt-align-center">
  <div class="flex flex-column gap <%= subject.status == 2 ? "banned" : "" %>">
    <div class="avatar txt-xx-large center" style="background: white">
      <img alt="Profile avatar" class="avatar" src="<%= ChatLayout.fresh_user_avatar_path(subject.id.not_nil!, subject.updated_at) %>">
    </div>
    <% if subject.role == 2 %><div class="pad-double--inline push--inline push--block-start"><% if subject.status == 0 %><form class="button_to" method="post" action="/rooms/directs?user_ids%5B%5D=<%= subject.id %>"><button class="btn btn--primary full-width txt--large"><%= icon("messages.svg") %></button></form><% else %><div><%= subject.name.to_s %> is no longer on this account</div><% end %></div><% elsif subject.status == 1 %><div><h1 class="txt-x-large margin-none"><%= subject.name.to_s %></h1><div><%= subject.name.to_s %> is no longer on this account</div></div><% else %><div class="flex flex-column gap" style="--row-gap: calc(var(--block-space) / 3)">
      <h1 class="txt-x-large txt-tight-lines margin-none"><%= subject.name.to_s %></h1>
      <% if viewer.role == 1 && subject.role != 2 %><div><a href="mailto:<%= subject.email_address.to_s %>"><%= subject.email_address.to_s %></a></div><% end %>
      <div><%= subject.bio.to_s %></div>
    </div>
    <% if subject.status == 0 %><div class="pad-inline-double margin-inline margin-block-start"><form action="/rooms/directs?user_ids%5B%5D=<%= subject.id %>" class="button_to" method="post"><button class="btn btn--reversed full-width txt-large" type="submit">
      <img aria-hidden="true" aria-label="Ping <%= subject.name.to_s %>" src="<%= asset("messages.svg") %>">
    </button></form>          </div>
    <% if viewer.role == 1 && viewer.id != subject.id %><hr class="margin-block-start borderless"><%= transfer_link(subject) %>
      <div class="margin-block-start">
        <form action="/users/<%= subject.id %>/ban" class="button_to" method="post"><button class="btn full-width" data-turbo-confirm="Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses." type="submit">
          <img aria-hidden="true" aria-label="Ban <%= subject.name.to_s %>" src="<%= asset("cancel.svg") %>">
          <span>Ban <%= subject.name.to_s %></span>
        </button></form>
      </div>
    <% end %>
    <% end %>
    <% if viewer.role == 1 && viewer.id != subject.id && subject.status == 2 %><div class="margin-block-start">
      <form action="/users/<%= subject.id %>/ban" class="button_to" method="post"><input name="_method" type="hidden" value="delete"><button class="btn btn--negative full-width" data-turbo-confirm="Are you sure you want to remove the ban on this user?" type="submit">
        <img aria-hidden="true" aria-label="Remove Ban <%= subject.name.to_s %>" src="<%= asset("cancel.svg") %>">
        <span>Remove ban</span>
      </button></form>
    </div><% end %><% end %></div>
</section>
<%= page_close %>
