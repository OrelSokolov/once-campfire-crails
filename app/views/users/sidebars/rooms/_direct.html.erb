<% members = direct_members(membership) %><a class="direct<%= unread?(membership) ? " unread" : "" %>" data-badge-dot-target="unread" data-room-id="<%= membership.room_id %>" data-rooms-list-target="room" data-sorted-list-number="<%= epoch_ms(membership.room.not_nil!) %>" data-sorted-list-target="item" href="/rooms/<%= membership.room_id %>" id="list_rooms_direct_<%= membership.room_id %>">
<% if members.size > 1 %>
<div class="avatar__group">
<% members.first(4).each do |m| %>
<span class="avatar">
<img aria-hidden="true" height="20" src="<%= avatar_path(m) %>" width="20">
</span>
<% end %>
</div>
<% else %>
<span class="avatar">
<img aria-hidden="true" height="48" src="<%= avatar_path(members.first) %>" width="48">
</span>
<% end %>
<span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
<span class="txt-nowrap overflow-ellipsis">
<span class="for-screen-reader">Ping with</span>
<%= direct_label(members) %>
</span>
</span>
</a>
