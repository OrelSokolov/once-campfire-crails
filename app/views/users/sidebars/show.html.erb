<turbo-cable-stream-source channel="Turbo::StreamsChannel" signed-stream-name="<%= rooms_stream %>"></turbo-cable-stream-source>
<turbo-cable-stream-source channel="Turbo::StreamsChannel" signed-stream-name="<%= user_rooms_stream %>"></turbo-cable-stream-source>
<div class="sidebar__container overflow-y overflow-hide-scrollbar" data-action="rooms-list:unread@window-&gt;badge-dot#update rooms-list:read@window-&gt;badge-dot#update turbo:submit-start-&gt;turbo-frame#unpermanize" data-badge-dot-unread-class="unread" data-controller="badge-dot">
<turbo-frame id="direct_rooms_control" target="_top">
<div class="directs gap overflow-x overflow-hide-scrollbar">
<a class="direct direct__new" data-turbo-frame="_self" href="/rooms/directs/new">
<span class="avatar avatar--icon">
<img aria-hidden="true" class="colorize--black" height="20" src="<%= asset("messages-add.svg") %>" width="20">
</span>
<span class="direct__author flex max-width min-width border-radius pad-inline-half">
<span class="for-screen-reader">New</span>
<span class="txt-small overflow-clip">Ping</span>
</span>
</a>
<div id="direct_rooms" contents data-controller="sorted-list" data-action="rooms-list:unread@window-&gt;sorted-list#updateItem">
<% directs.each do |d| %><a class="direct<%= d.unread ? " unread" : "" %>" data-badge-dot-target="unread" data-room-id="<%= d.room_id %>" data-rooms-list-target="room" data-sorted-list-number="<%= d.epoch_ms %>" data-sorted-list-target="item" href="/rooms/<%= d.room_id %>" id="list_rooms_direct_<%= d.room_id %>">
<% if d.members.size > 1 %>
<div class="avatar__group">
<% d.members.first(4).each do |m| %>
<span class="avatar">
<img aria-hidden="true" height="20" src="<%= avatar_path(m) %>" width="20">
</span>
<% end %>
</div>
<% else %>
<span class="avatar">
<img aria-hidden="true" height="48" src="<%= avatar_path(d.members.first) %>" width="48">
</span>
<% end %>
<span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
<span class="txt-nowrap overflow-ellipsis">
<span class="for-screen-reader">Ping with</span>
<%= direct_label(d) %>
</span>
</span>
</a><% end %></div>
<div contents>
<% placeholders.each do |u| %><form action="/rooms/directs?user_ids%5B%5D=<%= u.id %>" class="button_to" method="post"><button class="direct borderless fill-transparent unpad" type="submit">
<span class="avatar">
<img aria-hidden="true" src="<%= avatar_path(u) %>">
</span>
<span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
<span class="txt-nowrap overflow-ellipsis">
<span class="for-screen-reader">Start a ping with</span>
<%= u.name.to_s.split(" ")[0]? || "" %>
</span>
</span>
</button></form><% end %>
</div>
</div>
</turbo-frame>
<div class="rooms position-relative flex flex-column gap">
<div id="shared_rooms" contents data-controller="sorted-list">
<% shared.each do |s| %><a class="align-center gap room btn txt-nowrap<%= s.unread ? " unread" : "" %>" data-badge-dot-target="unread" data-room-id="<%= s.room.id %>" data-rooms-list-target="room" data-sorted-list-name="<%= s.room.name %>" data-sorted-list-target="item" href="/rooms/<%= s.room.id %>" id="list_<%= route_key(s.room) %>_<%= s.room.id %>" style="--column-gap: 0.5em">
<span class="overflow-ellipsis"><%= s.room.name %></span>
</a><% end %></div>
<% if new_room_allowed? %>
<a aria-label="New Chat Room" class="rooms__new-btn btn room align-center gap txt-reversed" href="/rooms/opens/new">
<img aria-hidden="true" height="20" src="<%= asset("add.svg") %>" width="20" style="view-transition-name: new-room">
</a><% end %>    </div>
<button class="btn sidebar__toggle" data-action="toggle-class#toggle">
<img aria-hidden="true" height="20" src="<%= asset("menu.svg") %>" width="20">
<span class="for-screen-reader">Open menu</span>
</button>
</div>
<div class="flex align-end sidebar__tools gap justify-end">
<a class="btn avatar flex-item-no-shrink sidebar__tool" href="/users/me/profile">
<img aria-hidden="true" height="48" src="<%= avatar_path(user) %>" width="48" style="view-transition-name: avatar-<%= user.id %>">
<span class="for-screen-reader">My Settings</span>
</a>
<a class="btn align-center gap txt-reversed sidebar__tool" href="/account/edit">
<img aria-hidden="true" height="20" src="<%= asset("settings.svg") %>" width="20" style="view-transition-name: account-settings">
<span class="for-screen-reader">Account Settings</span>
</a>  </div>
