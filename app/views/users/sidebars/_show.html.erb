<turbo-cable-stream-source channel="Turbo::StreamsChannel" signed-stream-name="<%= rooms_stream %>"></turbo-cable-stream-source>
<turbo-cable-stream-source channel="Turbo::StreamsChannel" signed-stream-name="<%= user_rooms_stream %>"></turbo-cable-stream-source>
<div
  data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize"
  data-badge-dot-unread-class="unread"
  data-controller="badge-dot" class="sidebar__container overflow-y overflow-hide-scrollbar">
  <turbo-frame id="direct_rooms_control" target="_top">
    <div class="directs gap overflow-x overflow-hide-scrollbar">
      <a class="direct direct__new" data-turbo-frame="_self" href="<%= new_rooms_direct_path %>">
        <span class="avatar avatar--icon">
          <img aria-hidden="true" class="colorize--black" height="20" src="<%= asset("messages-add.svg") %>" width="20"/>
        </span>
        <span class="direct__author flex max-width min-width border-radius pad-inline-half">
          <span class="for-screen-reader">New</span>
          <span class="txt-small overflow-clip">Ping</span>
        </span>
      </a>
      <div contents data-action="rooms-list:unread@window->sorted-list#updateItem" data-controller="sorted-list" id="direct_rooms">
        <%= render partial: "users/sidebars/rooms/direct", collection: directs, as_local: "membership", cached: true %></div>
        <div contents>
      <%= render partial: "users/sidebars/rooms/direct_placeholder", collection: placeholders, as_local: "user" %>
        </div>
      </div>
    </turbo-frame>
  <div class="rooms position-relative flex flex-column gap">
  <div id="shared_rooms" contents data-controller="sorted-list">
    <% shared.each do |s| %><%= render partial: "users/sidebars/rooms/shared", locals: {"room" => s.room, "unread" => s.unread} %><% end %></div>
    <% if new_room_allowed? %>
      <a aria-label="New Chat Room" class="rooms__new-btn btn room align-center gap txt-reversed" href="<%= new_rooms_open_path %>">
        <img aria-hidden="true" height="20" src="<%= asset("add.svg") %>" width="20" style="view-transition-name: new-room"/>
      </a><% end %>    </div>
  <button class="btn sidebar__toggle" data-action="toggle-class#toggle">
    <img aria-hidden="true" height="20" src="<%= asset("menu.svg") %>" width="20"/>
    <span class="for-screen-reader">Open menu</span>
  </button>
</div>
<div class="flex align-end sidebar__tools gap justify-end">
  <a class="btn avatar flex-item-no-shrink sidebar__tool" href="/users/me/profile">
    <img aria-hidden="true" height="48" src="<%= avatar_path(user) %>" width="48" style="view-transition-name: avatar-<%= user.id %>"/>
    <span class="for-screen-reader">My Settings</span>
  </a>
  <a class="btn align-center gap txt-reversed sidebar__tool" href="<%= edit_account_path %>">
    <img aria-hidden="true" height="20" src="<%= asset("settings.svg") %>" width="20" style="view-transition-name: account-settings"/>
    <span class="for-screen-reader">Account Settings</span>
  </a>  </div>
