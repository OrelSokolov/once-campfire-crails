<%= page_open %><form action="/join/<%= @account.not_nil!.join_code.to_s %>" accept-charset="UTF-8" method="post" class="center"><section class="nametag u-relative"><div class="flex justify-center align-center pad-block"><img src="<%= lanyard_src %>" class="nametag__lanyard" aria-hidden="true"></div>
<div class="nametag__inner flex flex-column gap"><fieldset class="flex flex-column center-block"><legend class="txt-align-center flex gap"><figure class="account-logo avatar"><img src="<%= app_logo_src %>" alt="Account logo" width="300" height="300"></figure><strong class="txt-large"><%= @account.not_nil!.name.to_s %></strong></legend><label class="align-center center avatar__form gap"><div class="btn avatar input--file txt-xx-large"><img src="<%= default_avatar_src %>" aria-hidden="true" alt="Avatar"></div></label></fieldset>
<div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input class="input" autocomplete="name" placeholder="Name" autofocus required data-1p-ignore="true" type="text" name="user[name]" id="user_name"><%= icon("person.svg", 24, "colorize--black") %></label></div>
<div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input class="input" autocomplete="username" placeholder="Email address" required type="email" name="user[email_address]" id="user_email_address"><%= icon("email.svg", 24, "colorize--black") %></label></div>
<div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input class="input" autocomplete="new-password" placeholder="Password" required maxlength="72" type="password" name="user[password]" id="user_password"><%= icon("password.svg", 24, "colorize--black") %></label></div>
<button class="btn btn--reversed center txt-large" type="submit"><%= icon("check.svg") %><span class="for-screen-reader">Save</span></button>
</section></form>
<%= page_close %>