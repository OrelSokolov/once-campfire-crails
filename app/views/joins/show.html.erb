<% @page_title = "Join #{@account.not_nil!.name.to_s}" %>
<% @body_class = "signup" %>

<% content_for :nav do %>
  <div class="flex-item-justify-end">
    <a href="<%= new_session_path %>" class="btn flex-item-justify-end"><%= icon("login-keys.svg") %><span class="for-screen-reader">Sign in</span></a>
  </div>
<% end %>

<%= form_with model: @user.not_nil!, url: join_path(@account.not_nil!.join_code.to_s), class: "center" do |form| %><section class="nametag u-relative"><div class="flex justify-center align-center pad-block"><img src="<%= lanyard_src %>" class="nametag__lanyard" aria-hidden="true"></div>
  <div class="nametag__inner flex flex-column gap"><fieldset class="flex flex-column center-block"><legend class="txt-align-center flex gap"><figure class="account-logo avatar"><img src="<%= app_logo_src %>" alt="Account logo" width="300" height="300"></figure><strong class="txt-large"><%= @account.not_nil!.name.to_s %></strong></legend><label class="align-center center avatar__form gap"><div class="btn avatar input--file txt-xx-large"><img src="<%= default_avatar_src %>" aria-hidden="true" alt="Avatar"></div></label></fieldset>
    <div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><%= form.text_field :name, class: "input", autocomplete: "name", placeholder: "Name", autofocus: true, required: true, data: {"1p-ignore" => true} %><%= icon("person.svg", 24, "colorize--black") %></label></div>
    <div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><%= form.email_field :email_address, class: "input", autocomplete: "username", placeholder: "Email address", required: true %><%= icon("email.svg", 24, "colorize--black") %></label></div>
    <div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><%= form.password_field :password, class: "input", autocomplete: "new-password", placeholder: "Password", required: true, maxlength: 72 %><%= icon("password.svg", 24, "colorize--black") %></label></div>
  <%= form.button class: "btn btn--reversed center txt-large", type: "submit" do %><%= icon("check.svg") %><span class="for-screen-reader">Save</span><% end %>
</section><% end %>
