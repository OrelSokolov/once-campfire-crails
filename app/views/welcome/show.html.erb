<% @page_title = "No rooms yet" %>
<% @body_class = "sidebar" %>
<% content_for :sidebar do %>
  <%= sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<% end %>

<div id="message-area" class="message-area">
  <div class="message-area--empty min-width center">
    <figure class="center pad">
      <img class="colorize--black translucent" aria-hidden="true" src="<%= messages_empty_src %>">
      <span class="for-screen-reader"><%= @user.not_nil!.name.to_s %></span>
    </figure>
  </div>
</div>
