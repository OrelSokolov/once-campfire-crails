<%= head %><body class="sidebar" data-controller="local-time lightbox">
<a href="#main-content" class="skip-navigation btn">Skip to main content</a>
<nav id="nav">
</nav>
<main id="main-content">
<div id="message-area" class="message-area">
<div class="message-area--empty min-width center">
<figure class="center pad"><img class="colorize--black translucent" aria-hidden="true" src="<%= messages_empty_src %>"><span class="for-screen-reader"><%= @user.not_nil!.name.to_s %></span>
</figure>
</div>
</div>
<footer id="footer"></footer></main>
<aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open"><turbo-frame id="user_sidebar" src="/users/me/sidebar" data-turbo-permanent="true" target="_top" data-controller="rooms-list read-rooms turbo-frame" data-rooms-list-unread-class="unread" data-action="presence:present@window->rooms-list#read read-rooms:read->rooms-list#read turbo:frame-load->rooms-list#loaded refresh-room:visible@window->turbo-frame#reload"></turbo-frame></aside>
<a href="https://once.com" id="app-logo" target="_blank" aria-label="Once software from 37signals home page"><img alt="Campfire logo" src="<%= campfire_icon_src %>" width="256" height="216"></a>
</body></html>
