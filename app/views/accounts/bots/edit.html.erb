<%= page_open("Edit chat bot", "/account/bots") %><section class="panel">
<form accept-charset="UTF-8" action="/account/bots/<%= @bot.not_nil!.id.not_nil! %>" class="flex flex-column gap" method="post"><input type="hidden" name="_method" value="patch">
<h1 class="for-screen-reader">Chat Bot Setup</h1>
<label class="align-center center avatar__form gap" data-controller="upload-preview">
<div class="btn input--file">
<%= icon("camera.svg") %>
<input accept="image/*" class="input" data-action="upload-preview#previewImage" data-upload-preview-target="input" id="user_avatar" name="user[avatar]" type="file">
<span class="for-screen-reader">Upload bot avatar</span>
</div>
<div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);">
<img alt="Bot avatar" data-upload-preview-target="image" height="48" src="<%= bot_avatar_src %>" width="48">
</div>
</label>
<div class="flex align-center gap">
<%= translation_button("bot_name") %>
<label class="flex align-center gap flex-item-grow txt-large input input--actor">
<input autocomplete="name" autofocus="autofocus" class="input" data-1p-ignore="true" id="user_name" name="user[name]" placeholder="Name the bot" required="required" type="text" value="<%= @bot.try(&.name).to_s %>">
<%= icon("bot.svg", 24, "colorize--black") %>
</label>
</div>
<div class="flex align-center gap">
<%= translation_button("webhook_url") %>
<label class="flex align-center gap flex-item-grow txt-large input input--actor">
<input class="input" id="user_webhook_url" name="user[webhook_url]" placeholder="Webhook URL" type="url" value="<%= @bot.try(&.webhook_url).to_s %>">
<%= icon("web.svg", 24, "colorize--black") %>
</label>
</div>
<button class="btn btn--reversed center txt-large" type="submit"><%= icon("check.svg") %><span class="for-screen-reader">Save changes</span></button>
</form>
<hr class="separator full-width margin-block-double"><div class="flex align-center gap justify-space-between"><form action="/account/bots/<%= @bot.not_nil!.id.not_nil! %>" method="post"><input type="hidden" name="_method" value="delete"><button class="btn txt--small btn--negative" aria-label="Delete this chat bot" data-turbo-confirm="Are you sure you want to permanently remove this bot from the account? This can’t be undone."><%= icon("trash.svg") %><%= icon("bot.svg") %></button></form>
</div>
</section>
<%= page_close %>
