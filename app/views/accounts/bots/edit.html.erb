<% @page_title = "Edit chat bot" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_bots_path %>
  </div>
<% end %>
<section class="panel">
  <%= form_with model: @bot.not_nil!, url: account_bot_path(@bot.not_nil!), class: "flex flex-column gap" do |form| %>
    <%= render partial: "accounts/bots/form", locals: {"form" => form, "bot" => @bot.not_nil!} %>
  <% end %>
  <hr class="separator full-width margin-block-double"><div class="flex align-center gap justify-space-between"><form action="/account/bots/<%= @bot.not_nil!.id! %>" method="post"><input type="hidden" name="_method" value="delete"><button class="btn txt--small btn--negative" aria-label="Delete this chat bot" data-turbo-confirm="Are you sure you want to permanently remove this bot from the account? This can’t be undone."><%= icon("trash.svg") %><%= icon("bot.svg") %></button></form><form action="/account/bots/<%= @bot.not_nil!.id! %>/key" method="post"><input type="hidden" name="_method" value="put"><button class="btn full-width txt--small btn--negative" aria-label="Generate a new key" data-turbo-confirm="Are you sure you want to change the bot key? All usage of this bot must be updated."><%= icon("refresh.svg") %><%= icon("key.svg") %></button></form>
  </div>
</section>
