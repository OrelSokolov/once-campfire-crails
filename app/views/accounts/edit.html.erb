<%= page_open(@user.not_nil!) %><section class="panel txt-align-center flex flex-column gap" style="view-transition-name: account-settings">
  <% if @user.not_nil!.role == 1 %>
    <div class="align-center center avatar__form gap" data-controller="upload-preview">
      <form accept-charset="UTF-8" action="/account.<%= @account.not_nil!.id.not_nil! %>" class="txt--medium" data-controller="form" enctype="multipart/form-data" method="post"><input type="hidden" name="_method" value="patch">
        <label class="btn input--file">
          <%= icon("camera.svg") %>
          <input accept="image/*" class="input" data-action="upload-preview#previewImage change-&gt;form#submit" id="account_logo" name="account[logo]" type="file">
          <span class="for-screen-reader">Upload logo</span>
        </label>
      </form>
      <form accept-charset="UTF-8" action="/account.<%= @account.not_nil!.id.not_nil! %>" data-controller="form" enctype="multipart/form-data" method="post"><input type="hidden" name="_method" value="patch">
        <label class="btn avatar input--file account-logo txt-xx-large">
          <img data-upload-preview-target="image" role="presentation" src="<%= logo_src %>" width="48" height="48">
          <input accept="image/*" class="input" data-action="upload-preview#previewImage change-&gt;form#submit" id="account_logo" name="account[logo]" type="file">
          <span class="for-screen-reader">Upload logo</span>
        </label>
      </form>
      <% if @account.not_nil!.logo_attachment %><form action="<%= logo_src %>" class="button_to" method="post"><input type="hidden" name="_method" value="delete"><button class="btn btn--negative txt-small avatar__delete-btn" type="submit"><%= icon("minus.svg") %><span class="for-screen-reader">Delete logo</span></button></form><% end %>
    </div>
    <form accept-charset="UTF-8" action="/account.<%= @account.not_nil!.id.not_nil! %>" class="flex flex-column gap" data-controller="form" method="post"><input type="hidden" name="_method" value="patch">
      <div class="flex align-center gap">
        <%= translation_button("account_name") %>
        <label class="flex align-center gap flex-item-grow">
          <input name="account[name]" value="<%= @account.not_nil!.name.to_s %>" id="account_name" class="input txt-large" autocomplete="off" placeholder="Name this account" type="text" autofocus="autofocus" data-action="keydown.enter-&gt;form#submit">
        </label>
        <button class="btn btn--reversed center" name="button" type="submit">
          <%= icon("check.svg") %>
          <span class="for-screen-reader">Save changes</span>
        </button>      </div>
    </form>
    <div class="margin-block-start pad-block pad-inline-double fill-shade border-radius">
      <form accept-charset="UTF-8" action="/account.<%= @account.not_nil!.id.not_nil! %>" class="flex align-center gap center" data-controller="form" method="post"><input type="hidden" name="_method" value="put">
        <div class="flex-item-grow flex align-center gap txt-align-start">
          <%= icon("crown.svg", 18, "colorize--black") %> Must be admin to create new rooms
        </div>
        <input type="hidden" id="account_settings_restrict_room_creation_to_administrators" name="account[settings][restrict_room_creation_to_administrators]" value="<%= @restrict ? "false" : "true" %>">
        <label class="switch">
          <input type="checkbox" class="switch__input"<%= @restrict ? %( checked="checked") : "" %> data-action="change->form#submit">
          <span class="switch__btn round"></span>
          <span class="for-screen-reader">
            Must be admin to create new rooms
          </span>
        </label>
      </form>    </div>
  <% else %><figure class="account-logo avatar txt-xx-large center"><img src="<%= logo_src %>" alt="Account logo" width="300" height="300"></figure>
    <h1 class="flex-item-grow txt-x-large"><%= @account.not_nil!.name.to_s %></h1>
  <% end %>
  <div class="margin-block pad-inline pad-block-start fill-shade border-radius">
    <div class="flex flex-column align-center gap">
      <label class="flex flex-column gap full-width" style="--row-gap: 0.5em">
        <strong id="invite_label" class="invite-label">Share to invite more people</strong>
        <span class="flex align-center gap input input--actor fill-white">
          <%= icon("person-add.svg", 20, "colorize--black") %>
          <input type="text" class="input" id="invite_url" value="<%= @join_url %>" aria-labelledby="invite_label" readonly>
        </span>
      </label>
      <div class="flex align-center gap">
        <a href="<%= @qr_path %>" class="btn" data-lightbox-target="image" data-action="lightbox#open" data-lightbox-url-value="<%= @qr_path %>">
          <span class="for-screen-reader">Show join link QR code</span>
          <%= icon("qr-code.svg", 20, "colorize--black") %>
        </a>
        <%= copy_button(@join_url) %>
        <button class="btn" data-action="web-share#share" data-controller="web-share" data-web-share-text-value="Hit this link to join me in Campfire and start chatting." data-web-share-title-value="Link to join Campfire" data-web-share-url-value="<%= @join_url %>" hidden="hidden">
          <span class="for-screen-reader">Share join link</span>
          <%= icon("share.svg", 20, "colorize--black") %>
        </button>
        <% if @user.not_nil!.role == 1 %><form action="/account/join_code" class="button_to" method="post"><button class="btn btn--regenerate" type="submit">
          <%= icon("refresh.svg", 20, "colorize--black") %>
          <span class="for-screen-reader">Regenerate join link</span>
        </button></form><% end %>  </div>
    </div>
    <hr class="margin-block separator full-width" style="--border-style: solid">
    <menu class="flex flex-column gap margin-none pad">
      <turbo-frame id="account_users">
        <% @admins.each do |u| %><%= account_user_row(u) %><% end %>
<% if !@admins.empty? && !@members.empty? %><hr class="separator full-width" style="--border-style: solid">
        <% end %><% @members.each do |u| %><%= account_user_row(u) %><% end %>
      </turbo-frame></menu></div>
</section>
<%= page_close %>
