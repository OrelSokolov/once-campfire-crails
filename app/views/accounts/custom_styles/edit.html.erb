<% @page_title = "Custom CSS" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to edit_account_path %>
  </div>
<% end %>
<section class="panel panel--wide txt-align-center flex flex-column position-relative" style="view-transition-name: custom-styles"><%= form_with model: @account.not_nil!, url: account_custom_styles_path, class: "flex flex-column gap", data: {action: "keydown.ctrl+enter->form#submit keydown.meta+enter->form#submit", controller: "form"} do |form| %>
    <div class="panel__button">
      <%= translation_button("custom_styles") %>
    </div>
    <div class="pad-inline-double margin-inline">
      <h1 class="margin-none">Custom CSS</h1>
      <p class="flex flex-wrap align-center justify-center gap margin-none-block-start" style="--column-gap: 0.5ch; --row-gap: 0">
        <span>Add custom CSS styles.</span>
        <%= icon("alert.svg", 16, "flex-inline colorize--black") %>
        <span>Use Caution: you could break things.</span>
      </p>
    </div>
    <label class="flex align-start gap flex-item-grow">
      <%= form.text_area :custom_styles, class: "input input--code txt--small", placeholder: "Add CSS styles…", autocomplete: "off", spellcheck: "false", autocorrect: "off", autocapitalize: "off", rows: 16, required: false %>
    </label>
    <%= form.button class: "btn btn--reversed center txt-large", type: "submit" do %><%= icon("check.svg") %><span class="for-screen-reader">Save changes</span><% end %>
    <% end %></section>
