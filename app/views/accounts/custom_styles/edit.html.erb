<%= page_open(@user.not_nil!) %><section class="panel panel--wide txt-align-center flex flex-column position-relative" style="view-transition-name: custom-styles"><form accept-charset="UTF-8" action="/account/custom_styles" class="flex flex-column gap" data-action="keydown.ctrl+enter-&gt;form#submit keydown.meta+enter-&gt;form#submit" data-controller="form" method="post"><input type="hidden" name="_method" value="patch">
<div class="panel__button">
<%= translation_button("custom_styles") %>
</div>
<div class="pad-inline-double margin-inline">
<h1 class="margin-none">Custom CSS</h1>
<p class="flex flex-wrap align-center justify-center gap margin-none-block-start" style="--column-gap: 0.5ch; --row-gap: 0">
<span>Add custom CSS styles.</span>
<%= icon("alert.svg", 16, "flex-inline colorize--black") %>
<span>Use Caution: you could break things.</span>
</p>
</div>
<label class="flex align-start gap flex-item-grow">
<textarea name="account[custom_styles]" id="account_custom_styles" class="input input--code txt--small" placeholder="Add CSS styles…" autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="off" rows="16"><%= @account.not_nil!.custom_styles.to_s %></textarea>
</label>
<button class="btn btn--reversed center txt-large" name="button" type="submit"><%= icon("check.svg") %><span class="for-screen-reader">Save changes</span>
</button>
</form></section>
<%= page_close %>
