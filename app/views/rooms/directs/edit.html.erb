<%= page_open("Edit settings for #{@direct_title}", "/rooms/#{@room.not_nil!.id!}") %><div class="panel txt-align-center">
  <section class="directs--edit margin-block-end">
    <% @direct_members.each do |member| %><div class="member flex flex-column gap fill-shade pad border-radius">
      <figure class="avatar center" style="--avatar-border-radius: 10ch; --avatar-size: 10ch;">
        <%= avatar_link(member) %>
      </figure>

      <strong><%= member.name.to_s %></strong>
    </div>
    <% end %></section>
  <%= button_to room_url(@room.not_nil!.id!), method: "delete", class: "btn btn--negative center", aria: {label: "Delete Ping"}, data: {turbo_confirm: "Are you sure you want to delete this ping and all messages in it? This can’t be undone."} do %><%= icon("trash.svg") %>Ping<% end %>
</div>
<%= page_close %>
