<%= turbo_frame_tag(dom_id("involvement"), data: {controller: "turbo-frame", action: "notifications:ready@window->turbo-frame#load", turbo_frame_url_param: "/rooms/#{room.id}/involvement"}) do %><%= button_to "/rooms/#{room.id}/involvement?involvement=#{next_involvement}", method: "put", role: "checkbox", aria: {checked: true, labelledby: dom_id("involvement_label")}, tabindex: 0, class: "btn #{involvement}" do %><img src="<%= asset("notification-bell-#{involvement}.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader" id="<%= dom_id("involvement_label") %>"><%= human_involvement %></span><% end %><% end %>
