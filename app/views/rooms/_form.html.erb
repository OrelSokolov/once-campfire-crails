<%= page_open(room ? "Edit room" : "New room", room ? "/rooms/#{room.id.not_nil!}" : "/") %><section class="panel txt-align-center" style="view-transition-name: <%= room ? "edit-room-#{room.id.not_nil!}" : "new-room" %>"><form method="post" action="/rooms/<%= kind %><%= room ? "/#{room.id.not_nil!}" : "" %>" accept-charset="UTF-8"><% if room %><input type="hidden" name="_method" value="patch"><% end %><div class="flex align-center gap"><% if can_administer %><label class="flex-item-grow txt-large"><input name="room[name]" id="room_name" class="input full-width" required autofocus placeholder="Name the room" data-turbo-permanent="true" data-action="keydown.enter->form#submit:prevent" type="text" value="<%= room.try(&.name).to_s %>"><span class="for-screen-reader">Name this room</span></label><% else %><h1 class="flex-item-grow txt-x-large"><%= room.try(&.name).to_s %></h1><% end %></div>
<hr class="margin-block borderless">
<section class="room-access margin-block pad-inline fill-shade border-radius"><menu class="flex flex-column gap margin-none pad overflow-y constrain-height" data-controller="filter" data-filter-active-class="filter--active" data-filter-selected-class="selected">
<% if can_administer || is_open %><% other = is_open ? "closeds" : "opens" %><li class="flex align-center gap margin-none"><figure class="avatar flex-item-no-shrink" style="--avatar-border-radius: 0; --avatar-size: 4ch"><img aria-hidden="true" class="colorize--black" style="background-color: transparent" src="<%= everyone_src %>"><span class="for-screen-reader">Everyone</span></figure><div class="min-width"><div class="overflow-ellipsis fill-shade"><strong>Everyone</strong></div></div><hr class="separator" aria-hidden="true"><% if can_administer %><a class="btn--faux flex-inline" tabindex="-1" data-turbo-action="replace" href="/rooms/<%= other %><%= room ? "/#{room.id.not_nil!}/edit" : "/new" %>"><label for="room_type" class="switch"><input type="checkbox" id="room_type" class="switch__input"<%= is_open ? " checked" : "" %>"><span class="switch__btn round"></span><span class="for-screen-reader"><%= is_open ? "Give only some access to this room" : "Give everyone access to this room" %></span></label></a><% end %></li>
<hr class="separator full-width" style="--border-style: solid">
<% end %><input type="search" id="search" autocorrect="off" autocomplete="off" data-1p-ignore="true" class="input input--transparent full-width" <%= users.size > 20 ? "placeholder=\"Filter…\" data-action=\"input->filter#filter\">\n" : "" %><div data-filter-target="list" contents><% users.each_with_index do |member, i| %><% mid = member.id.not_nil! %><% if divider > 0 && i == divider %><hr class="separator full-width" style="--border-style: solid"><% end %><li class="flex align-center gap margin-none" data-value="<%= member.name.to_s.downcase %>"><figure class="avatar flex-item-no-shrink" style="--avatar-size: 4ch"><a title="<%= member.name.to_s %>" class="btn avatar" data-turbo-frame="_top" href="/users/<%= mid %>"><img aria-hidden="true" loading="lazy" src="/users/<%= mid %>/avatar" width="48" height="48"></a></figure><div class="min-width"><div class="overflow-ellipsis fill-shade"><strong><%= member.name.to_s %></strong></div></div><hr class="separator" aria-hidden="true"><% if can_administer %><% if is_open || (room.nil? && mid == user.id.not_nil!) %><% unless is_open %><input type="hidden" name="user_ids[]" value="<%= mid %>"><% end %><%= icon("check.svg", 20, "colorize--black flex-item-no-shrink") %><% else %><label class="switch flex-item-no-shrink"><input type="checkbox" name="user_ids[]" value="<%= mid %>" class="switch__input"<%= selected.includes?(mid) ? " checked" : "" %>><span class="switch__btn round"></span><span class="for-screen-reader">Give <%= member.name.to_s %> access to this room</span></label><% end %><% end %></li>
<% end %></div></menu></section>
<% if can_administer %><button name="button" type="submit" class="btn btn--reversed txt-large center"><%= icon("check.svg") %><span class="for-screen-reader">Save</span></button>
<% end %></form></section>
<% if room && can_administer %><section class="panel txt-align-center"><form class="button_to" method="post" action="/rooms/<%= room.id.not_nil! %>"><input type="hidden" name="_method" value="delete"><button class="btn btn--negative max-width" aria-label="Delete <%= room.name.to_s %>" data-turbo-confirm="Are you sure you want to delete this room and all messages in it? This can’t be undone." type="submit"><%= icon("trash.svg") %><span class="overflow-ellipsis"><%= room.name.to_s %></span></button></form></section>
<% end %><%= page_close %>