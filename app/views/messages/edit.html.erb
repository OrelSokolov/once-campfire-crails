<turbo-frame id="edit_message_<%= @mid %>">
  <div class="message__body position-relative" data-controller="scroll-into-view">
    <div class="message__body-content message__body-content--editing gap">
      <% if @attachment %><%= attachment_html %><div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half"><button name="button" type="submit" class="btn btn--negative center margin-block-end" form="delete_form_message_<%= @mid %>" data-turbo-confirm="Are you sure you want to delete this message?"><%= icon("trash.svg") %><span class="for-screen-reader">Delete message</span></button>
      </div>
      <% else %><div class="composer--edit composer--rich-text">
        <%= form_with model: @message.not_nil!, url: room_message_path(room.not_nil!.id, mid), id: "form_message_#{mid}", data: {controller: "form", action: "lexxy:file-accept->form#preventAttachment keydown.esc->form#cancel keydown.ctrl+enter->form#submit:prevent keydown.meta+enter->form#submit:prevent"} do |form| %>
          <div class="full-width input input--actor min-width fill-white"><%= form.rich_text_area :body,
                value: @message.not_nil!.body.to_s,
                rows: 1,
                class: "input lexxy-content",
                aria: { multiline: "true", label: "Edit message" },
                autofocus: true,
                "permitted-attachment-types": "application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed",
                data: { action: rich_text_data_actions } do %><%= mention_prompt_tag @room.not_nil! %><% end %>
          </div>
          <a data-form-target="cancel" hidden="hidden" href="<%= room_message_path(room.not_nil!.id, mid) %>">Close editor and discard changes</a>
          <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half"><button name="button" type="submit" class="btn btn--reversed"><%= icon("check.svg") %><span class="for-screen-reader">Save changes</span></button>
            <button name="button" type="submit" class="btn btn--negative" form="delete_form_message_<%= @mid %>" data-turbo-confirm="Are you sure you want to delete this message?"><%= icon("trash.svg") %><span class="for-screen-reader">Delete message</span></button>
          </div>
        <% end %></div>
      <% end %></div>
    <div class="message__actions flex flex-wrap"><a class="message__action-btn message__edit-close-btn txt-small btn btn--borderless" href="<%= room_message_path(room.not_nil!.id, mid) %>"><%= icon("remove.svg", cls: "colorize--black") %><span class="for-screen-reader">Close editor and discard changes</span></a></div>
    <%= form_with url: room_message_path(room.not_nil!.id, mid), method: "delete", id: "delete_form_message_#{mid}", data: {"turbo-frame" => "edit_message_#{mid}"} %>
  </div>
</turbo-frame>
