<%= page_open("Edit chat bot", "/account/bots") %><section class="panel"><form action="/account/bots/<%= @bot.not_nil!.id.not_nil! %>" accept-charset="UTF-8" method="post" class="flex flex-column gap"><input type="hidden" name="_method" value="patch"><h1 class="for-screen-reader">Chat Bot Setup</h1>
<label class="align-center center avatar__form gap"><div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);"><img src="<%= bot_avatar_src %>" alt="Bot avatar" width="48" height="48"></div></label>
<div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input type="text" name="user[name]" id="user_name" value="<%= @bot.try(&.name).to_s %>" class="input" autocomplete="name" placeholder="Name the bot" autofocus required data-1p-ignore="true"><%= icon("bot.svg", 24, "colorize--black") %></label></div>
<div class="flex align-center gap"><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input type="url" name="user[webhook_url]" id="user_webhook_url" value="<%= @bot.try(&.webhook_url).to_s %>" class="input" placeholder="Webhook URL"><%= icon("web.svg", 24, "colorize--black") %></label></div>
<button class="btn btn--reversed center txt-large" type="submit"><%= icon("check.svg") %><span class="for-screen-reader">Save changes</span></button>
</form>
<hr class="separator full-width margin-block-double"><div class="flex align-center gap justify-space-between"><form action="/account/bots/<%= @bot.not_nil!.id.not_nil! %>" method="post"><input type="hidden" name="_method" value="delete"><button class="btn txt--small btn--negative" aria-label="Delete this chat bot" data-turbo-confirm="Are you sure you want to permanently remove this bot from the account? This can’t be undone."><%= icon("trash.svg") %><%= icon("bot.svg") %></button></form>
</div>
</section>
<%= page_close %>